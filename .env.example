# Скопируйте в .env и подставьте ключ из кабинета Sber.
# .env в git не попадает.

LLM_PROVIDER=gigachat

# Basic-ключ из https://developers.sber.ru/ (физлицо, freemium)
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Локальная модель без ключа:
# LLM_PROVIDER=ollama
# затем: docker compose --profile ollama up -d --build
